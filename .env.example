# ==============================================================================
# VIBE ENGLISH - ENVIRONMENT CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# SERVER-ONLY SECRETS (Do NOT prefix with VITE_ / Never expose to client)
# ------------------------------------------------------------------------------

# GEMINI_API_KEY:
# Required by the serverless backend (/api/ai/word-details) to interact with Google Gemini AI.
# In production, set this in Vercel Project Settings -> Environment Variables.
# In local development, add this to your local .env file.
GEMINI_API_KEY="your_gemini_api_key_here"

# FIREBASE_PROJECT_ID (Optional):
# Override Firebase Project ID used to verify Firebase ID tokens on serverless functions.
# If omitted, it automatically falls back to projectId in firebase-applet-config.json.
# FIREBASE_PROJECT_ID="gen-lang-client-0338054309"

# ------------------------------------------------------------------------------
# PUBLIC CLIENT CONFIG
# ------------------------------------------------------------------------------
# Firebase client SDK configuration is loaded from firebase-applet-config.json.
# Public client configuration contains standard client credentials (apiKey, projectId, etc.).

# VITE_FIREBASE_VAPID_KEY:
# Required for opt-in Web/PWA push notifications. This Firebase Web Push key is public.
VITE_FIREBASE_VAPID_KEY="your_public_web_push_vapid_key_here"
