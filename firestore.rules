rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // --- Connectivity Test Path ---
    match /test/connection {
      allow read: if true;
    }

    // --- Helpers ---
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function hasValidSynonyms(data) {
      return (!('synonymIds' in data)
          || (data.synonymIds is map && data.synonymIds.size() <= 10))
        && (!('customSynonyms' in data)
          || (data.customSynonyms is map && data.customSynonyms.size() <= 10))
        && (!('synonymIds' in data) || !('customSynonyms' in data)
          || data.synonymIds.size() + data.customSynonyms.size() <= 10);
    }

    function preservesLegacySynonyms(data, previousData) {
      return data.keys().hasAny(['synonymIds']) == previousData.keys().hasAny(['synonymIds'])
        && data.keys().hasAny(['customSynonyms']) == previousData.keys().hasAny(['customSynonyms'])
        && (!('synonymIds' in data)
          || (data.synonymIds is list && data.synonymIds == previousData.synonymIds))
        && (!('customSynonyms' in data)
          || (data.customSynonyms is list && data.customSynonyms == previousData.customSynonyms));
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Validation Blueprints ---

    function isValidTopic(data) {
      return data.keys().hasAll(['name', 'userId', 'createdAt'])
        && data.keys().size() == 3
        && data.name is string && data.name.size() > 0 && data.name.size() <= 100
        && data.userId == request.auth.uid
        && data.createdAt is timestamp;
    }

    function isValidVocabularyBase(data) {
      return data.keys().hasAll(['word', 'definition', 'partOfSpeech', 'phonetic', 'topicId', 'userId', 'createdAt', 'updatedAt', 'level', 'nextReview'])
        && data.word is string && data.word.size() > 0 && data.word.size() <= 100
        && (!('normalizedWord' in data) || (data.normalizedWord is string && data.normalizedWord.size() > 0 && data.normalizedWord.size() <= 100))
        && data.definition is string && data.definition.size() > 0 && data.definition.size() <= 500
        && data.partOfSpeech is string && data.partOfSpeech.size() <= 50
        && data.phonetic is string && data.phonetic.size() <= 100
        && (data.topicId == null || data.topicId is string)
        && data.userId == request.auth.uid
        && data.createdAt is timestamp
        && data.updatedAt is timestamp
        && (data.nextReview == null || data.nextReview is timestamp);
    }

    function isValidLegacyVocabulary(data) {
      return isValidVocabularyBase(data)
        && data.level is int && data.level >= 0 && data.level <= 5
        && !data.keys().hasAny(['srsVersion', 'intervalDays', 'easeFactor', 'repetitions', 'lapses', 'lastReviewedAt']);
    }

    function isValidSrsVocabulary(data) {
      return isValidVocabularyBase(data)
        && data.keys().hasAll(['srsVersion', 'intervalDays', 'easeFactor', 'repetitions', 'lapses', 'lastReviewedAt', 'normalizedWord'])
        && data.normalizedWord is string && data.normalizedWord.size() > 0 && data.normalizedWord.size() <= 100
        && data.srsVersion == 1
        && data.intervalDays is int && data.intervalDays >= 0 && data.intervalDays <= 3650
        && (data.easeFactor is float || data.easeFactor is int) && data.easeFactor >= 1.3 && data.easeFactor <= 3.0
        && data.repetitions is int && data.repetitions >= 0
        && data.lapses is int && data.lapses >= 0
        && (data.lastReviewedAt == null || data.lastReviewedAt is timestamp)
        && data.level is int && data.level >= 0 && data.level <= 4;
    }

    function isValidVocabulary(data) {
      return 'srsVersion' in data
        ? isValidSrsVocabulary(data)
        : isValidLegacyVocabulary(data);
    }

    function isValidReviewEvent(data) {
      return data.keys().hasAll([
        'userId', 'vocabularyId', 'rating', 'previousLevel', 'newLevel',
        'previousIntervalDays', 'newIntervalDays', 'topicId', 'srsVersion', 'reviewedAt'
      ])
        && data.keys().size() == 10
        && data.userId == request.auth.uid
        && data.vocabularyId is string && data.vocabularyId.size() > 0 && data.vocabularyId.size() <= 128
        && data.rating in ['again', 'hard', 'good', 'easy']
        && data.previousLevel is int && data.previousLevel >= 0 && data.previousLevel <= 5
        && data.newLevel is int && data.newLevel >= 0 && data.newLevel <= 4
        && data.previousIntervalDays is int && data.previousIntervalDays >= 0 && data.previousIntervalDays <= 3650
        && data.newIntervalDays is int && data.newIntervalDays >= 0 && data.newIntervalDays <= 3650
        && (data.topicId == null || data.topicId is string)
        && data.srsVersion == 1
        && data.reviewedAt is timestamp;
    }

    function isValidNotificationDevice(data, userId) {
      return data.keys().hasAll(['userId', 'token', 'platform', 'createdAt', 'updatedAt'])
        && data.keys().size() == 5
        && data.userId == userId
        && data.token is string && data.token.size() > 0 && data.token.size() <= 4096
        && data.platform is string && data.platform.size() > 0 && data.platform.size() <= 300
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidWordUsage(data, vocabId) {
      return data.keys().hasAll(['userId', 'vocabularyId', 'word', 'examples', 'collocations', 'generatedAt'])
        && data.keys().size() == 6
        && data.userId == request.auth.uid
        && data.vocabularyId == vocabId
        && data.word is string && data.word.size() > 0 && data.word.size() <= 100
        && data.examples is list && data.examples.size() <= 5
        && data.collocations is list && data.collocations.size() <= 8
        && data.generatedAt == request.time;
    }

    function ownsVocabulary(vocabId) {
      return get(/databases/$(database)/documents/vocabularies/$(vocabId)).data.userId == request.auth.uid;
    }

    // --- Rules ---

    match /topics/{topicId} {
      allow get, delete: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;
      
      allow create: if isSignedIn() && isValidTopic(incoming())
        && incoming().createdAt == request.time;
      
      allow update: if isOwner(existing().userId) && isValidTopic(incoming())
        && incoming().createdAt == existing().createdAt
        && incoming().diff(existing()).affectedKeys().hasOnly(['name']);
    }

    match /vocabularies/{vocabId} {
      allow get, delete: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && isValidSrsVocabulary(incoming())
        && hasValidSynonyms(incoming())
        && incoming().keys().hasOnly([
          'word', 'normalizedWord', 'definition', 'partOfSpeech', 'phonetic', 'topicId',
          'userId', 'createdAt', 'updatedAt', 'level', 'nextReview', 'srsVersion',
          'intervalDays', 'easeFactor', 'repetitions', 'lapses', 'lastReviewedAt',
          'synonymIds', 'customSynonyms'
        ])
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time
        && incoming().nextReview == request.time
        && incoming().lastReviewedAt == null;

      allow update: if isOwner(existing().userId)
        && isValidVocabulary(incoming())
        && (hasValidSynonyms(incoming()) || preservesLegacySynonyms(incoming(), existing()))
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'word', 'normalizedWord', 'definition', 'partOfSpeech', 'phonetic', 'topicId', 'updatedAt',
          'level', 'nextReview', 'srsVersion', 'intervalDays', 'easeFactor',
          'repetitions', 'lapses', 'lastReviewedAt', 'synonymIds', 'customSynonyms'
        ]);
    }

    match /reviewEvents/{eventId} {
      allow get: if isOwner(existing().userId);
      allow list: if isSignedIn() && resource.data.userId == request.auth.uid;

      allow create: if isSignedIn() && isValidReviewEvent(incoming())
        && incoming().reviewedAt == request.time;

      allow update, delete: if false;
    }

    match /wordUsages/{vocabId} {
      // resource == null: reading or deleting a not-yet-generated cache must not fail (deleteVocabulary batches it).
      allow get, delete: if isSignedIn()
        && (resource == null || resource.data.userId == request.auth.uid);

      allow create: if isSignedIn()
        && isValidWordUsage(incoming(), vocabId)
        && ownsVocabulary(vocabId);

      allow update: if isOwner(existing().userId)
        && isValidWordUsage(incoming(), vocabId)
        && ownsVocabulary(vocabId);
    }

    match /notificationUsers/{userId}/devices/{installationId} {
      allow get, list: if isOwner(userId);

      allow create: if isOwner(userId)
        && isValidNotificationDevice(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;

      allow update: if isOwner(userId)
        && existing().userId == userId
        && isValidNotificationDevice(incoming(), userId)
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['token', 'platform', 'updatedAt']);

      allow delete: if isOwner(userId);
    }

    match /notificationDispatchStates/{userId} {
      allow read, write: if false;
    }
  }
}
